{
  "name": "Designer OS",
  "short_name": "DesignerOS",
  "description": "نظام شخصي متكامل لإدارة العمل الإبداعي للمصممين الفريلانس",
  "start_url": "./index.html",
  "scope": "./",
  "id": "/designer-os",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0b0f",
  "theme_color": "#0b0b0f",
  "lang": "ar",
  "dir": "rtl",
  "categories": ["productivity", "business", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Designer OS Dashboard"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Designer OS Mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "وضع التركيز",
      "short_name": "Focus",
      "url": "./index.html#/focus",
      "description": "ابدأ جلسة Pomodoro",
      "icons": [{"src": "./assets/icon-192.png", "sizes": "192x192"}]
    },
    {
      "name": "مهمة جديدة",
      "short_name": "Task",
      "url": "./index.html#/tasks?new=1",
      "description": "أضف مهمة جديدة",
      "icons": [{"src": "./assets/icon-192.png", "sizes": "192x192"}]
    },
    {
      "name": "الرئيسية",
      "short_name": "Home",
      "url": "./index.html#/",
      "description": "الصفحة الرئيسية",
      "icons": [{"src": "./assets/icon-192.png", "sizes": "192x192"}]
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
